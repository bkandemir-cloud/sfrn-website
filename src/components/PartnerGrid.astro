---
import { partners } from '../data/partners';

/**
 * Portrait lockups are allowed more height than horizontal ones, otherwise a
 * height-capped tall logo renders at roughly a third of the width of a wide one
 * and reads as the junior partner.
 */
const isPortrait = (partner: (typeof partners)[number]) =>
  Boolean(partner.width && partner.height && partner.height > partner.width);
---
<ul class="partner-grid">
  {partners.map((partner) => (
    <li class="partner-card">
      {partner.logo ? (
        <img
          class:list={['partner-logo', { 'is-portrait': isPortrait(partner) }]}
          src={partner.logo}
          alt={partner.alt ?? partner.name}
          width={partner.width}
          height={partner.height}
          loading="lazy"
          decoding="async"
        />
      ) : partner.mark ? (
        <span class="partner-lockup">
          <img
            class="partner-mark"
            src={partner.mark}
            alt=""
            width={partner.width}
            height={partner.height}
            loading="lazy"
            decoding="async"
          />
          <span class="partner-wordmark">{partner.name}</span>
        </span>
      ) : (
        <span class="partner-wordmark">{partner.name}</span>
      )}
    </li>
  ))}
</ul>

<style>
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }

  .partner-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 9.5rem;
    padding: 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-align: center;
  }

  .partner-card img {
    width: auto;
    max-width: 100%;
    max-height: 4rem;
    object-fit: contain;
  }

  .partner-card .partner-logo.is-portrait {
    max-height: 6.5rem;
  }

  .partner-lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    text-align: left;
  }

  .partner-lockup .partner-mark {
    flex: none;
    height: 2.75rem;
    max-height: 2.75rem;
  }

  .partner-wordmark {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.3;
    font-weight: 600;
    color: var(--navy);
    text-wrap: balance;
  }

  .partner-lockup .partner-wordmark {
    font-size: 1rem;
    text-wrap: pretty;
  }

  @media (max-width: 480px) {
    .partner-card { min-height: 8rem; }
    .partner-card .partner-logo.is-portrait { max-height: 5rem; }
    .partner-lockup { gap: 0.65rem; }
    .partner-lockup .partner-mark { height: 2.25rem; max-height: 2.25rem; }
  }
</style>
