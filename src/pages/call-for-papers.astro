---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'Who can submit?',
    a: [
      'Any current Sixth Form student (Year 12 or Year 13), at any UK state or independent school or college, whether or not your school is already part of the Network.',
      // Teacher/supervisor contact requirement from Beth (KAN-510). Phrasing by the
      // coordinator agent: BETH TO VET.
      'We do ask that you have a teacher or supervisor at your school or college who is aware that you are making the submission and who is happy to be contacted. Please supply an email address for this person when you submit.',
    ],
  },
  {
    // Opening paragraph supplied by Beth (KAN-510). Length line reworded by the
    // coordinator agent to carry her bracketed labels: BETH TO VET.
    q: 'What can I submit?',
    a: [
      'We publish articles: short, sharpened versions of a longer piece of research you have already carried out, such as an EPQ, Extended Essay or an independent project of your own. Your article should answer a specific research question or address a set title, so that a reader can see at once what you set out to find and what you concluded. Think of it as your original project refined and clipped to its essentials: the inquiry, the evidence and the argument.',
      'Articles should be roughly 1,500–4,000 words (completed project) or roughly 500–1,500 words (work in progress).',
    ],
  },
  {
    // Two-track and reflective-note wording moved here from "What can I submit?"
    // (KAN-510). Linking words by the coordinator agent: BETH TO VET.
    q: 'Does my project have to be finished?',
    a: [
      'No. There are two tracks, so a project doesn’t have to be finished to be worth sharing. Work in progress is warmly welcomed here, not treated as a lesser version of a finished article.',
      'If you are submitting work in progress, please include a short reflective note on your findings so far and where you’re heading next.',
    ],
  },
  {
    q: 'What citation style should I use?',
    a: 'We prefer APA-style in-text references and a reference list, but will also consider work formatted consistently in another major convention (Harvard, MLA or Chicago). Submissions with incomplete citations cannot be considered.',
  },
  {
    // Moved up from the end of the list so the review questions sit together (KAN-510).
    q: 'When does the Journal launch?',
    a: 'We’re aiming for our first articles to be published in Summer 2027. The journal will be free to read online. We will be taking rolling submissions from the 25th of September 2026. There may however be future calls for papers for special sections which are based around particular themes or subject-specific.',
  },
  {
    // "Who reviews submissions?" and "When will I hear back?" combined (KAN-510).
    q: 'Who reviews submissions, and when will I hear back?',
    a: 'Submissions are read by a growing editorial board of researchers and educators from across the Network. We aim to respond to all those sharing submissions within 3 months.',
  },
  {
    q: 'What feedback will I receive?',
    a: 'Your submission will be traffic-lighted with suggestions about how you might edit or evolve your piece of writing in order for it to be published in the journal.',
    // Grey box, matching the traffic light explainer that follows, at Beth's request (KAN-510).
    explainer: 'grey',
  },
  {
    // Explainer box for the previous question, shown in grey at Beth's request (KAN-510).
    // Heading wording supplied by Beth (KAN-517).
    q: 'What do the traffic light feedback tiers mean?',
    a: '‘Green’ would be very unusual and would mean that it could be published with no corrections. ‘Amber’ would give some suggestions of editing and development required for it to be ready for publication. ‘Red’ would suggest substantial changes are needed to be made in order for your piece to be published.',
    explainer: 'grey',
  },
];
---
<BaseLayout
  title="Call for Papers | Sixth Form Research Network"
  description="The Sixth Form Research Network is inviting submissions for the first issue of our journal, planned for Summer 2027. Finished pieces and work in progress both welcome."
>
  <section class="section page-head">
    <div class="container">
      <span class="kicker">Call for Papers</span>
      <h1>The first issue of the SFRN Journal</h1>
      <p class="lead">
        We&rsquo;re now inviting submissions for our first issue, planned for Summer 2027.
        Whether you have a finished project or something still taking shape, there&rsquo;s a
        place for your work here.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#submit">
          How to submit
        </a>
        <a class="btn btn-secondary" href="/journal/">
          About the journal
        </a>
      </div>
      <figure class="hero-photo">
        <img
          src="/images/call-for-papers-sapling-neon-blue.jpg"
          alt="Neon illustration in glowing blue of a small oak sapling, its roots spreading through the soil, growing in a clearing between tall mature trees"
          width="1024"
          height="1024"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ul class="card-grid faq-grid">
        {faqs.map((item) => (
          <li class:list={['card', { 'card-explainer-grey': item.explainer === 'grey' }]}>
            <h3>{item.q}</h3>
            {(Array.isArray(item.a) ? item.a : [item.a]).map((para) => <p>{para}</p>)}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-navy" id="submit">
    <div class="container cta-strip">
      <div>
        <h2>Ready to share your work?</h2>
      </div>
      <a class="btn btn-primary" href="https://forms.cloud.microsoft/e/iMUDyE6BE3" target="_blank" rel="noopener">
        Submit your work
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { padding-bottom: 0; }
  .page-head .lead { max-width: 44rem; }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .card h3 { margin-bottom: 0.4rem; }
  .faq-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
  }
  .card p { margin-bottom: 0; color: var(--muted); }
  .card p + p { margin-top: 0.8rem; }
  .card-explainer-grey {
    background: #eeeef1;
    border-color: #b9bac6;
  }
  .card-explainer-grey h3 { color: var(--navy-soft); }
  .card-explainer-grey p { color: var(--text); }

  .hero-photo {
    margin: 2rem 0 0;
  }
  .hero-photo img {
    width: 100%;
    max-width: 32rem;
    height: auto;
    border-radius: var(--radius);
    display: block;
  }
  .hero-photo figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .cta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cta-strip h2 { margin-bottom: 0.3rem; }
  .cta-strip p { margin: 0; }
</style>
