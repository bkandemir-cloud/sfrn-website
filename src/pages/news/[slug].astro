---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { news, type NewsPost } from '../../data/news';
import { marked } from 'marked';
import sanitizeHtml from 'sanitize-html';

export function getStaticPaths() {
  return news.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: NewsPost;
}

const { post } = Astro.props;

const html = sanitizeHtml(await marked.parse(post.content), {
  allowedTags: sanitizeHtml.defaults.allowedTags.concat(['img']),
  allowedAttributes: {
    ...sanitizeHtml.defaults.allowedAttributes,
    a: ['href', 'target', 'rel'],
    img: ['src', 'alt', 'loading'],
  },
  transformTags: {
    a: sanitizeHtml.simpleTransform('a', { rel: 'noopener' }),
  },
});

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  datePublished: post.date,
  publisher: {
    '@type': 'Organization',
    name: 'Sixth Form Research Network',
    url: 'https://sixthformresearchnetwork.co.uk',
  },
});
---
<BaseLayout title={`${post.title} | Sixth Form Research Network`} description={post.excerpt}>
  <script type="application/ld+json" set:html={jsonLd} />
  <article class="section">
    <div class="container prose">
      <p class="date">{post.displayDate}</p>
      <h1>{post.title}</h1>
      {post.video && (
        <figure class="clip">
          <p class="clip-quote">{post.video.pullQuote}</p>
          <video
            controls
            preload="none"
            playsinline
            poster={post.video.poster}
            width={post.video.width}
            height={post.video.height}
          >
            <source src={post.video.src} type="video/mp4" />
            <p>
              Your browser cannot play this video.
              <a href={post.video.src}>Download the clip</a> instead, or read the transcript below.
            </p>
          </video>
          <figcaption>{post.video.caption}</figcaption>
          <details class="transcript">
            <summary>Read the transcript</summary>
            <p>{post.video.transcript}</p>
          </details>
        </figure>
      )}
      <div set:html={html} />
      <p class="back"><a href="/news/">&larr; All news</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .date {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 0.6rem;
  }
  h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); }
  .back { margin-top: 2.5rem; }

  .clip {
    margin: 0 0 2rem;
  }
  .clip-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    line-height: 1.3;
    color: var(--navy);
    margin: 0 0 1rem;
  }
  .clip video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--navy);
    border-radius: var(--radius);
  }
  .clip figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .transcript {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }
  .transcript summary {
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--teal);
  }
  .transcript p {
    margin: 0.9rem 0 0;
    font-size: 0.98rem;
    color: var(--muted);
  }
</style>
